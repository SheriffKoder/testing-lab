# Names the app actually reads. Copy to gitignored `.env` and fill real values.
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional Item 7 RUM bridge — if set, LCP/INP/CLS are sendBeacon'd here.
# Leave empty for lab console-only reporting (non-production).
# NEXT_PUBLIC_WEB_VITALS_ENDPOINT=https://example.com/vitals
# Release/version stamped on each vital (defaults to "local" when unset).
# NEXT_PUBLIC_APP_VERSION=local
